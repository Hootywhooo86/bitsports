<?xml version="1.0" encoding="utf-8"?>
<!-- Score + heat map. The LED rink fills the widget; each team's shots light the end under its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/away_c1" android:layout_width="8dp" android:layout_height="16dp" android:background="#041E42" />
        <ImageView android:id="@+id/away_c2" android:layout_width="8dp" android:layout_height="16dp" android:background="#FC4C02" />
        <TextView
            android:id="@+id/away_abbrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/silkscreen_bold"
            android:text="EDM"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/silkscreen_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="3–2"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />
        <TextView
            android:id="@+id/home_abbrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/silkscreen_bold"
            android:text="CGY"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
        <ImageView android:id="@+id/home_c1" android:layout_width="8dp" android:layout_height="16dp" android:background="#C8102E" />
        <ImageView android:id="@+id/home_c2" android:layout_width="8dp" android:layout_height="16dp" android:background="#F1BE48" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/silkscreen_regular"
            android:maxLines="1"
            android:text="■ LIVE 2ND 08:44"
            android:textColor="#FF4D6D"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/shots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_regular"
            android:maxLines="1"
            android:text="SHOTS 21–17"
            android:textColor="#8C8C8C"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:adjustViewBounds="true"
        android:contentDescription="Shot heat map"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_board_preview" />
</LinearLayout>
