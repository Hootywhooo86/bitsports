<?xml version="1.0" encoding="utf-8"?>
<!-- NHL tonight: one LED arena board with every game. The board image is 128 LEDs wide. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/silkscreen_bold"
            android:maxLines="1"
            android:text="NHL TONIGHT"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_regular"
            android:maxLines="1"
            android:text="■ 3 LIVE"
            android:textColor="#FF4D6D"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:adjustViewBounds="true"
        android:contentDescription="Tonight's NHL scores"
        android:scaleType="fitStart"
        android:src="@drawable/widget_scores_preview" />

    <TextView
        android:id="@+id/more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/silkscreen_regular"
        android:maxLines="1"
        android:textColor="#6B6B6B"
        android:textSize="9sp" />
</LinearLayout>
