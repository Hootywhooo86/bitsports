<?xml version="1.0" encoding="utf-8"?>
<!-- Team score, 2x2 and up. The score is the one big thing; everything else is small.
     The text here doubles as the widget picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:id="@+id/crest_c1" android:layout_width="7dp" android:layout_height="14dp" android:background="#041E42" />
        <ImageView android:id="@+id/crest_c2" android:layout_width="7dp" android:layout_height="14dp" android:background="#FC4C02" />
        <TextView
            android:id="@+id/team"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/silkscreen_bold"
            android:maxLines="1"
            android:text="OILERS"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/silkscreen_regular"
            android:maxLines="1"
            android:text="■ LIVE"
            android:textColor="#FF4D6D"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Live or final: two big numbers, yours first. -->
    <LinearLayout
        android:id="@+id/score_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/my_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="56sp" />
            <TextView
                android:id="@+id/my_abbrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="EDM"
                android:textColor="#8C8C8C"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/their_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/silkscreen_regular"
                android:includeFontPadding="false"
                android:text="2"
                android:textColor="#6B6B6B"
                android:textSize="56sp" />
            <TextView
                android:id="@+id/their_abbrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/silkscreen_regular"
                android:text="@ CGY"
                android:textColor="#8C8C8C"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Before puck drop or no game: one large line instead of numbers. -->
    <TextView
        android:id="@+id/big_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/silkscreen_regular"
        android:gravity="bottom"
        android:maxLines="2"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="2nd 08:44 · Shots 21–17"
        android:textColor="#8C8C8C"
        android:textSize="12sp" />
</LinearLayout>
